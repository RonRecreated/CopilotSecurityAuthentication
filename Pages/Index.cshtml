@page
@model SecureLogin.Pages.IndexModel
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Account</title></head>
<body>
    <h1>Account</h1>
    <!-- Razor encodes this value as text. Never use Html.Raw for user data. -->
    <p>Welcome, @User.Identity?.Name!</p>
    <form method="post" asp-page-handler="Logout"><button type="submit">Logout</button></form>
</body>
</html>
